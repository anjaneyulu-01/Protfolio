# Backend — copy to .env and fill (DO NOT commit .env)
ATLAS_DB_URL=
PORTFOLIO_SECRET=
OWNER_EMAIL=
FRONTEND_URL=
PORT=8005
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BREVO_API_KEY=
EMAIL_FROM=auth@newroots.tech

# AI Assistant (ARIA) — primary provider + Gemini fallback. Empty = demo mode.
# The primary key auto-detects: "gsk_..." = Groq (api.groq.com),
# "xai-..." = xAI Grok (api.x.ai). Put it in XAI_API_KEY (or GROQ_API_KEY).
XAI_API_KEY=
# GROQ_API_KEY=            # alternative name for the primary key
# GROQ_MODEL=openai/gpt-oss-120b       # highest-capability Groq model (used with a gsk_ key)
# XAI_MODEL=grok-3                      # used when the key is an xAI (xai-) key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
OWNER_NAME=Anjaneyulu
ASSISTANT_NAME=ARIA
